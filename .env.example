# --- LANGFUSE ---
LANGFUSE_SECRET_KEY=REPLACE_ME
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_HOST=REPLACE_ME

# --- DATABASE (PostgreSQL) ---
POSTGRES_DB=mbw_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_HOST=REPLACE_ME
POSTGRES_PORT=5432

# --- REDIS ---
REDIS_SCHEME=redis
REDIS_HOST=REPLACE_ME
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME
REDIS_DB=0

# --- CELERY ---
CELERY_BROKER_URL=${REDIS_SCHEME}://${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=${REDIS_SCHEME}://${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- AI / MODEL CONFIG (VLM) ---
# Đổi tên model hoặc URL nếu cần
VLM_MODEL=REPLACE_ME
VLM_BASE_URL=REPLACE_ME
VLM_API_KEY=REPLACE_ME
VLM_MAX_RETRIES=3
VLM_TEMPERATURE=0.3

# --- MASTER KEY ---
MASTER_KEY="REPLACE_ME"

# --- API SERVER ---
API_HOST=0.0.0.0
API_PORT=8000

# --- KEY DÙNG CHO EVALUATION ---
GOOGLE_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
EVAL_JUDGE_API_KEY=REPLACE_ME